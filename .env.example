# Updated: Example environment configuration for helper scripts.
# Docker runtime values live in docker/.env (copied from docker/.env.example).
CADDY_ADMIN_EMAIL=admin@example.com

# Umami database credentials
# Dummy defaults for CI builds; override with secure values in production.
UMAMI_DB_PASS=examplepassword
UMAMI_APP_SECRET=examplesecret

# Terraform helper variables used by scripts/tf-plan.sh
DO_TOKEN=replace-with-digitalocean-token
# Optional: existing uploaded DigitalOcean SSH key fingerprint.
# If omitted, Terraform will create and use a key from SSH_PUBLIC_KEY or SSH_PUBLIC_KEY_PATH.
SSH_KEY_FINGERPRINT=

# Optional key input overrides.
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
# SSH_PUBLIC_KEY=ssh-ed25519 AAAA... your@email

# Optional DNS automation (DigitalOcean DNS hosted zone must already exist).
MANAGE_DNS_RECORDS=false
DOMAIN_NAME=example.com

# Per-service variables follow the SERVICE_<NAME>_* naming convention.
SERVICE_SAMPLE_DOMAIN=sample.example.com
SERVICE_SAMPLE_IMAGE=ghcr.io/example/sample:latest
SERVICE_SAMPLE_PORT=3000

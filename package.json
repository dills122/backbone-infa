{
  "name": "backbone-infa-dev-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Local lint/validation wrapper for backbone-infa",
  "scripts": {
    "prepare": "lefthook install",
    "hooks:install": "lefthook install",
    "lint": "npm-run-all --print-label lint:yaml lint:md lint:shell lint:compose lint:terraform:fmt",
    "lint:yaml": "yamllint docker templates .github .lefthook.yml",
    "lint:md": "markdownlint-cli2",
    "lint:shell": "bash scripts/lint-shell.sh",
    "lint:compose": "bash scripts/validate-compose-config.sh",
    "lint:terraform:fmt": "terraform -chdir=terraform fmt -check -recursive",
    "validate:terraform": "bash scripts/validate-terraform.sh",
    "validate": "npm-run-all --print-label lint validate:terraform"
  },
  "devDependencies": {
    "lefthook": "^1.7.16",
    "markdownlint-cli2": "^0.18.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2"
  }
}

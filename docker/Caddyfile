# Backbone Caddy entrypoint: terminates TLS and routes web traffic per README service onboarding.
{
  email {$CADDY_ADMIN_EMAIL}
  acme_ca https://acme-v02.api.letsencrypt.org/directory
}
# Root domain
dsteele.dev {
  encode gzip zstd
  root * /srv/sites/coming-soon
  file_server
}

# Blog subdomain
blog.dsteele.dev {
  encode gzip zstd
  root * /srv/sites/blog
  file_server
}

# Umami analytics
umami.dsteele.dev {
  encode gzip zstd
  reverse_proxy backbone-umami:3000
}

# Additional service/site routes.
import /etc/caddy/sites.d/*.caddy
